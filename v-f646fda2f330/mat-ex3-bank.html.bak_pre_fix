<script>
function jumpToChart(){document.querySelector('.svg-card').scrollIntoView({behavior:'smooth',block:'start'});}

const STORAGE_KEY = 'mat_ex3_bank_last';
const HISTORY_KEY = 'mat_ex3_bank_history';

// Report this attempt to The System (index.html badges + the-system.html dashboard).
const SYS_EXAM_ID = 'mat-ex3-bank';
const SYS_EXAM_LABEL = 'Maternity Exam 3 \u2014 Leifer Bank';
function reportToSystem(rec){
  try{
    const src = rec.ch || rec.cat || {};
    const chapters = {};
    Object.keys(src).forEach(function(k){
      const v = src[k];
      if (Array.isArray(v)) chapters[k] = {correct: v[0], total: v[1]};
      else if (v && typeof v === 'object') chapters[k] = {correct: v.earned, total: v.total};
    });
    localStorage.setItem(SYS_EXAM_ID + '-last', JSON.stringify({
      score: rec.pct, correct: rec.earned, total: rec.total, date: rec.date, chapters: chapters
    }));
    localStorage.setItem(SYS_EXAM_ID + '-label', SYS_EXAM_LABEL);
    const hist = JSON.parse(localStorage.getItem('examHistory') || '[]');
    hist.push({examId: SYS_EXAM_ID, examLabel: SYS_EXAM_LABEL, date: (function(){ const d = new Date(rec.date); return isNaN(d.getTime()) ? new Date().toISOString() : d.toISOString(); })(),
      score: rec.pct, correct: rec.earned, total: rec.total, topicBreakdown: chapters});
    localStorage.setItem('examHistory', JSON.stringify(hist.slice(-1000)));
  }catch(e){}
}


// One-time backfill: replay the newest pre-existing attempt into The System.
(function(){
  try{
    if (localStorage.getItem(SYS_EXAM_ID + '-last')) return;
    const legacy = JSON.parse(localStorage.getItem(HISTORY_KEY) || '[]');
    if (!Array.isArray(legacy) || !legacy.length) return;
    const r = legacy[legacy.length - 1];
    if (r && typeof r.pct === 'number') reportToSystem(r);
  }catch(e){}
})();

const MAX_HISTORY = 40;

// SATA is graded the way her program grades it: all correct = 1, some correct
// with nothing wrong = 0.5, any wrong pick = 0. MC needs no special case.
function creditFor(selectedOis, correctOis){
  if(!selectedOis.length) return 0;
  if(selectedOis.some(oi=>!correctOis.includes(oi))) return 0;
  return selectedOis.length===correctOis.length ? 1 : 0.5;
}
const r1=n=>Math.round(n*10)/10;
const tone=p=>p>=78?'#22c55e':p>=60?'#fbbf24':'#ef4444';

function loadHistory(){
  try{ const a=JSON.parse(localStorage.getItem(HISTORY_KEY)||'[]'); return Array.isArray(a)?a:[]; }catch(e){ return []; }
}
function saveHistory(h){ try{ localStorage.setItem(HISTORY_KEY, JSON.stringify(h.slice(-MAX_HISTORY))); }catch(e){} }

let clearArmed=false;
function clearHistory(){
  const btns=document.querySelectorAll('.btn-clear');
  if(!clearArmed){
    clearArmed=true; btns.forEach(b=>b.textContent='Tap again to confirm');
    setTimeout(()=>{clearArmed=false;document.querySelectorAll('.btn-clear').forEach(b=>b.textContent='Clear history');},4000);
    return;
  }
  clearArmed=false;
  try{ localStorage.removeItem(HISTORY_KEY); localStorage.removeItem(STORAGE_KEY); }catch(e){}
  renderHistory();
}

function renderHistory(){
  const els=[document.getElementById('histPanelTop'),document.getElementById('histPanelBottom')].filter(Boolean);
  const h=loadHistory();
  if(!h.length){ els.forEach(el=>el.innerHTML='<div class="hist-empty">No attempts recorded yet. Finish a run and it lands here.</div>'); return; }
  const best=Math.max(...h.map(r=>r.pct));
  let bestShown=false;
  const rows=h.slice().reverse().map(r=>{
    const isBest=r.pct===best&&!bestShown; if(isBest) bestShown=true;
    const sata=r.sata?` <span class="h-date">&middot; SATA ${r.sata.full}F/${r.sata.half}H/${r.sata.zero}Z</span>`:'';
    return `<div class="hist-row${isBest?' best':''}"><span class="h-date">${r.date}</span>${r.filter?` <span class=\"h-date\" style=\"color:#a78bfa\">${r.filter}</span>`:''}<span><span class="h-score" style="color:${tone(r.pct)}">${r.earned}/${r.total} &middot; ${r.pct}%</span>${isBest?' <span class="h-date">best</span>':''}${sata}</span></div>`;
  }).join('');
  const agg={};
  h.forEach(r=>Object.entries(r.ch||{}).forEach(([ch,v])=>{ if(!agg[ch])agg[ch]={e:0,t:0}; agg[ch].e+=v[0]; agg[ch].t+=v[1]; }));
  const weak=Object.keys(agg).map(ch=>({ch,p:Math.round(agg[ch].e/agg[ch].t*100)})).sort((a,b)=>a.p-b.p);
  const weakBlock = weak.length
    ? `<h3>Chapter averages (${h.length} attempt${h.length>1?'s':''}</h3>`+weak.map(w=>`<div class="weak-row"><span class="w-ch">${w.ch}</span><span class="weak-bar"><i style="width:${w.p}%;background:${tone(w.p)}"></i></span><span class="h-score" style="color:${tone(w.p)}">${w.p}%</span></div>`).join('')+`<div class="hist-note">Sorted weakest first — red chapters are where your reps go, green ones are locked in.</div>`
    : '';
  const html=`<h3>Attempt history (${h.length})</h3>${rows}${weakBlock}<button class="btn-clear" onclick="clearHistory()">Clear history</button>`;
  els.forEach(el=>el.innerHTML=html);
}

