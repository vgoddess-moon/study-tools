];
let questions = [];

function applyFilter(mode){
  activeMode=mode;
  if(mode === 'quiz10') questions = shuffle(BANKQ.slice()).slice(0,10);
  else if(mode === 'draw40') questions = shuffle(BANKQ.slice()).slice(0,40);
  else if(mode === 'all') questions = BANKQ.slice();
  else if(mode === 'sata') questions = shuffle(BANKQ.filter(function(q){ return q.type === 'SATA'; }));
  else questions = BANKQ.filter(function(q){ return q.ch === mode; });
  document.querySelectorAll('.fbtn').forEach(function(b){
    b.classList.toggle('active', b.getAttribute('data-f') === mode);
  });
  document.getElementById('filterNote').textContent =
    mode === 'quiz10' ? 'Ten questions, mixed across all 7 chapters \u2014 the shape of her class-night quiz. Tap again for a fresh ten.'
    : mode === 'draw40' ? 'Random 40 across all 7 chapters. Tap Random 40 again for a fresh set.'
    : mode === 'all' ? 'All ' + BANKQ.length + ' items loaded. This is a marathon, not a warm-up.'
    : mode === 'sata' ? questions.length + ' select-all items, shuffled. This is the format that costs you points \u2014 half credit for incomplete, zero for any wrong pick.'
    : questions.length + ' items from ' + mode + '.';
  document.getElementById('scoreCard').style.display = 'none';
  if(state.scored){ const h = loadHistory(); h.pop(); saveHistory(h); state.scored = false; renderHistory(); }
  buildQuiz();
  window.scrollTo({top:0, behavior:'smooth'});
}

function shuffle(arr){ for(let i=arr.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1));[arr[i],arr[j]]=[arr[j],arr[i]]; } return arr; }

let activeMode='quiz10';
const state = { answered: [], score: 0, shuffledOpts: [], lastTap: 0, scored: false };

function buildQuiz(){
  state.answered = new Array(questions.length).fill(null);
  state.score = 0;
  state.scored = false;
  state.shuffledOpts = questions.map(q => shuffle([...q.opts.map((o,i)=>({...o,origIdx:i}))]));
  const area = document.getElementById('quizArea');
  area.innerHTML = '';
  questions.forEach((q,qi) => {
    const letters = ['A','B','C','D','E','F'];
    const card = document.createElement('div');
    card.className = 'q-card';
    card.id = 'q'+qi;
    const vulnBadge = q.vuln==='low' ? '<span class="badge badge-vlow">Vocab swap</span>'
                    : q.vuln==='high' ? '<span class="badge badge-vhigh">Numbers move</span>' : '';
    const badges = `<span class="badge badge-ch">${q.ch}</span>${q.type==='SATA'?'':'<span class="badge badge-type">MC</span>'}${vulnBadge}${q.isNew?'<span class="badge badge-new">New</span>':''}${q.f8?'<span class="badge badge-f8">Final Eight</span>':''}${q.alert?'<span class="badge badge-alert">She said it</span>':''}${q.miss?'<span class="badge badge-miss">You missed this</span>':''}${q.type==='SATA'?'<span class="badge badge-sata">SATA</span>':''}`;
    const sataHint = q.type==='SATA' ? '<div class="sata-hint">Select all that apply &mdash; a wrong pick scores <b>zero</b>; all-correct-but-incomplete earns <b>half credit</b>. Leave the maybes unchecked, but never leave it blank.</div>' : '';
    const optsHtml = state.shuffledOpts[qi].map((o,oi)=>`
      <div class="opt" id="q${qi}o${oi}" onclick="toggleOpt(${qi},${oi})">
        <span class="opt-letter">${letters[oi]}</span>
        <span class="opt-text">${o.t}<div class="opt-rationale" id="q${qi}r${oi}">${o.r}</div></span>
      </div>`).join('');
    card.innerHTML = `
      <div class="q-top"><span class="q-num">Q${qi+1}</span>${badges}</div>
      <div class="q-stem">${q.stem}</div>
      ${sataHint}
      <div class="opts">${optsHtml}</div>
      <button class="btn-submit" onclick="submitQ(${qi})" id="btn${qi}" disabled>Submit</button>`;
    area.appendChild(card);
  });
  updateProgress();
  const h=loadHistory();
  if(h.length){
    const last=h[h.length-1];
    document.getElementById('lastAttempt').style.display='block';
    document.getElementById('lastScore').textContent=last.pct+'%';
    document.getElementById('lastDate').textContent=last.date;
  }
  renderHistory();
}

function toggleOpt(qi,oi){
  if(state.answered[qi]!==null) return;
  state.lastTap=Date.now();
  const q=questions[qi];
  const el=document.getElementById(`q${qi}o${oi}`);
  if(q.type==='SATA'){
    el.classList.toggle('selected');
  } else {
    document.querySelectorAll(`#q${qi} .opt`).forEach(e=>e.classList.remove('selected'));
    el.classList.add('selected');
  }
  const anySelected = document.querySelectorAll(`#q${qi} .opt.selected`).length > 0;
  document.getElementById(`btn${qi}`).disabled = !anySelected;
}

function submitQ(qi){
  if(state.answered[qi]!==null) return;
  if(Date.now()-state.lastTap < 350) return;
  const q=questions[qi];
  const sopts=state.shuffledOpts[qi];
  const card=document.getElementById('q'+qi);
  const anchorTop=card.getBoundingClientRect().top;
  const selectedEls = [...document.querySelectorAll(`#q${qi} .opt.selected`)];
  const selectedOis = selectedEls.map(el=>parseInt(el.id.split('o')[1]));
  const correctOis = sopts.map((o,oi)=>o.c?oi:-1).filter(v=>v>=0);
  const credit = creditFor(selectedOis, correctOis);
  state.answered[qi] = credit;
  state.score += credit;
  sopts.forEach((o,oi)=>{
    const el=document.getElementById(`q${qi}o${oi}`);
    const rat=document.getElementById(`q${qi}r${oi}`);
    if(o.c){ el.classList.add('correct-show'); el.classList.remove('selected'); }
    else if(selectedOis.includes(oi)){ el.classList.add('wrong-show'); el.classList.remove('selected'); }
    rat.style.display='block';
  });
  if(q.teach && !document.getElementById('t'+qi)){
    const tb=document.createElement('div');
    tb.className='q-teach'; tb.id='t'+qi;
    tb.innerHTML='<span class="q-teach-lbl">Anchor</span>'+q.teach;
    card.querySelector('.opts').insertAdjacentElement('afterend', tb);
  }
  card.classList.add(credit===1?'answered-correct':credit===0.5?'answered-partial':'answered-wrong');
  document.getElementById(`btn${qi}`).disabled=true;
  if(!document.getElementById('u'+qi)){
    const ub=document.createElement('button');
    ub.className='q-undo'; ub.id='u'+qi;
    ub.textContent='Undo \u2014 I tapped the wrong one';
    ub.onclick=function(){ undoQ(qi); };
    document.getElementById('btn'+qi).insertAdjacentElement('afterend', ub);
  }
  const drift=card.getBoundingClientRect().top-anchorTop;
  if(drift) window.scrollBy(0, drift);
  updateProgress();
  if(state.answered.every(a=>a!==null)) showScore();
}

function updateProgress(){
  const done=state.answered.filter(a=>a!==null).length;
  document.getElementById('progressBar').style.width=(done/questions.length*100)+'%';
}

function showScore(){
  const total=questions.length;
  const earned=r1(state.score);
  const pct=Math.round(earned/total*100);
  document.getElementById('finalScore').textContent=pct+'%';
  const goal=pct>=90;
  const sata={full:0,half:0,zero:0};
  questions.forEach((q,i)=>{ if(q.type!=='SATA') return; const c=state.answered[i]; sata[c===1?'full':c===0.5?'half':'zero']++; });
  document.getElementById('finalText').textContent=
    `${earned} / ${total} points — ${goal?'At your 90 target':pct>=78?'Passing, but under your 90 target':'Below passing (need 78%+)'}`
    +(sata.full+sata.half+sata.zero ? ` · SATA: ${sata.full} full, ${sata.half} half, ${sata.zero} zero` : '');
  const byChapter={};
  questions.forEach((q,i)=>{ if(!byChapter[q.ch]) byChapter[q.ch]={earned:0,total:0}; byChapter[q.ch].total++; byChapter[q.ch].earned+=state.answered[i]||0; });
  const bw=document.getElementById('breakdownArea');
  bw.innerHTML=Object.entries(byChapter).map(([ch,v])=>{
    const p=Math.round(v.earned/v.total*100);
    return `<div class="breakdown-row"><span class="bd-label">${ch}</span><span class="bd-score" style="color:${tone(p)}">${r1(v.earned)}/${v.total} (${p}%)</span></div>`;
  }).join('');
  const _now=new Date();const _dt=_now.toLocaleDateString()+' '+_now.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});const rec={date:_dt,filter:activeMode,pct:pct,earned:earned,total:total,sata:sata,
    ch:Object.fromEntries(Object.entries(byChapter).map(([k,v])=>[k,[r1(v.earned),v.total]]))};
  const h=loadHistory(); h.push(rec); saveHistory(h); state.scored=true;
  localStorage.setItem(STORAGE_KEY, JSON.stringify({score:pct+'%',date:rec.date}));
  reportToSystem(rec);
  renderHistory();
  document.getElementById('scoreCard').style.display='block';
  document.getElementById('scoreCard').scrollIntoView({behavior:'smooth',block:'start'});
  const _nm=state.answered.filter(function(a){return a===0;}).length;  const _mb=document.getElementById('drillMissedBtn');  if(_mb){_mb.style.display=_nm>0?'block':'none';  _mb.textContent='Drill missed — '+_nm+(_nm===1?' question':' questions');}
  const nMissed = state.answered.filter(function(a){ return a===0; }).length;
  const mb = document.getElementById('drillMissedBtn');
  if(mb){ mb.style.display = nMissed > 0 ? 'block' : 'none';
    mb.textContent = 'Drill missed — ' + nMissed + (nMissed===1?' question':' questions'); }
}


function drillMissed(){
  const missed = [];
  for(let qi=0;qi<questions.length;qi++){
    if(state.answered[qi]===0) missed.push(questions[qi]);
  }
  if(!missed.length) return;
  questions = shuffle(missed.slice());
  document.getElementById('scoreCard').style.display='none';
  buildQuiz();
  const qw = document.getElementById('quizArea') || document.getElementById('quizWrap');
  if(qw) qw.scrollIntoView({behavior:'smooth', block:'start'});
}
function undoQ(qi){
  if(state.answered[qi]===null) return;
  state.score-=state.answered[qi];
  state.answered[qi]=null;
  const card=document.getElementById('q'+qi);
  card.classList.remove('answered-correct','answered-partial','answered-wrong');
  state.shuffledOpts[qi].forEach(function(o,oi){
    const el=document.getElementById('q'+qi+'o'+oi);
    el.classList.remove('correct-show','wrong-show','selected');
    document.getElementById('q'+qi+'r'+oi).style.display='none';
  });
  const tb=document.getElementById('t'+qi); if(tb) tb.remove();
  const ub=document.getElementById('u'+qi); if(ub) ub.remove();
  document.getElementById('btn'+qi).disabled=true;
  // A finished attempt already banked a score; undoing an item retracts it so the
  // history keeps only the run she actually meant to give.
  if(state.scored){
    const h=loadHistory(); h.pop(); saveHistory(h);
    state.scored=false; renderHistory();
    document.getElementById('lastAttempt').style.display=h.length?'block':'none';
    if(h.length){
      document.getElementById('lastScore').textContent=h[h.length-1].pct+'%';
      document.getElementById('lastDate').textContent=h[h.length-1].date;
    }
  }
  document.getElementById('scoreCard').style.display='none';
  updateProgress();
  state.lastTap=Date.now();
  card.scrollIntoView({block:'center'});
}

function hardReset(){
  if(state.scored){ const h=loadHistory(); h.pop(); saveHistory(h); state.scored=false; }
  restartQuiz();
}

function restartQuiz(){
  document.getElementById('scoreCard').style.display='none';
  buildQuiz();
  window.scrollTo({top:0,behavior:'smooth'});
}

applyFilter('quiz10');
</script>
