<title>Maternity Exam 3 - Leifer Test Bank (Ch 15, 21, 22, 24, 25, 26, 34)</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=DM+Serif+Display&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{background:#0c0f14;color:#e2e8f0;font-family:'DM Sans',sans-serif;line-height:1.6;padding:1rem;min-height:100vh}
h1,h2,h3{font-family:'DM Serif Display',serif}
.container{max-width:860px;margin:0 auto}
.exam-header{text-align:center;padding:2rem 1rem;margin-bottom:1.5rem}
.exam-header h1{font-size:2rem;color:#f8fafc;margin-bottom:.25rem}
.exam-header .subtitle{color:#94a3b8;font-size:.95rem}
.exam-info{background:#1a1f2e;border:1px solid #334155;border-radius:10px;padding:1rem 1.25rem;margin-bottom:1rem;font-size:.9rem;color:#cbd5e1;text-align:center}
.svg-card{background:#13181f;border:1px solid #1e293b;border-radius:12px;padding:1.25rem;margin-bottom:1.5rem;overflow-x:auto}
.svg-card h3{color:#fb7185;font-size:1rem;margin-bottom:.75rem;text-align:center}
.last-attempt{background:#1e293b;border:1px solid #334155;border-radius:10px;padding:1rem;margin-bottom:1.5rem;display:none;text-align:center;font-size:.9rem;color:#94a3b8}
.last-attempt .score-val{font-size:1.5rem;font-weight:700;color:#fb7185}
.progress-wrap{background:#1e293b;border-radius:99px;height:8px;margin-bottom:2rem;overflow:hidden;position:sticky;top:.5rem;z-index:50}
.progress-bar{height:100%;background:linear-gradient(90deg,#e11d48,#fb7185);border-radius:99px;transition:width .3s}
.q-card{background:#13181f;border:1px solid #1e293b;border-radius:12px;padding:1.5rem;margin-bottom:1.25rem;transition:border-color .2s}
.q-card.answered-correct{border-color:#22c55e}
.q-card.answered-wrong{border-color:#ef4444}
.q-card.answered-partial{border-color:#fbbf24}
.q-top{display:flex;align-items:center;gap:.5rem;margin-bottom:.75rem;flex-wrap:wrap}
.q-num{font-family:'IBM Plex Mono',monospace;font-size:.75rem;color:#64748b}
.badge{font-size:.65rem;padding:.2rem .5rem;border-radius:99px;font-weight:600;text-transform:uppercase;letter-spacing:.03em}
.badge-ch{background:#0a1f2a;color:#7dd3fc}
.badge-type{background:#0a2018;color:#6ee7b7}
.badge-new{background:#1a0a2a;color:#c4b5fd;border:1px solid #7c3aed}
.badge-f8{background:#052e16;color:#6ee7b7;border:1px solid #22c55e}
.badge-miss{background:#7c2d12;color:#fdba74;border:1px solid #ea580c}
.badge-alert{background:#2a1505;color:#fbbf24;border:1px solid #b45309}
.badge-sata{background:#2a0a16;color:#fda4af;border:1px solid #e11d48}
.badge-vlow{background:#08202b;color:#7dd3fc;border:1px solid #0369a1}
.badge-vhigh{background:#2a1605;color:#fdba74;border:1px solid #c2410c}
.q-stem{font-size:1rem;color:#f1f5f9;margin-bottom:1rem}
.sata-hint{font-size:.8rem;color:#fda4af;font-style:italic;margin-bottom:.75rem}
.opts{display:flex;flex-direction:column;gap:.5rem;margin-bottom:1rem}
.opt{background:#0c0f14;border:1px solid #1e293b;border-radius:8px;padding:.75rem 1rem;cursor:pointer;transition:all .15s;display:flex;align-items:flex-start;gap:.6rem}
.opt:hover{border-color:#334155;background:#161b24}
.opt.selected{border-color:#fb7185;background:#2a0a16}
.opt.correct-show{border-color:#22c55e;background:#052e16}
.opt.wrong-show{border-color:#ef4444;background:#2a0a0a}
.opt-letter{font-family:'IBM Plex Mono',monospace;font-size:.75rem;font-weight:600;color:#64748b;min-width:1.2rem;padding-top:.05rem}
.opt-text{font-size:.9rem;flex:1}
.opt-rationale{display:none;font-size:.8rem;color:#94a3b8;margin-top:.35rem;padding-top:.35rem;border-top:1px solid #1e293b;line-height:1.5}
.btn-submit{background:#e11d48;color:#fff;border:none;border-radius:8px;padding:.6rem 1.5rem;font-size:.85rem;font-weight:600;cursor:pointer;transition:background .2s}
.btn-submit:hover{background:#be123c}
.btn-submit:disabled{opacity:.4;cursor:not-allowed}
.score-card{background:#13181f;border:1px solid #1e293b;border-radius:12px;padding:2rem;margin-top:2rem;display:none;text-align:center}
.score-card h2{font-size:1.5rem;margin-bottom:.5rem}
.big-score{font-size:3rem;font-weight:700;color:#fb7185;margin:.5rem 0}
.breakdown-wrap{margin-top:1.5rem;text-align:left}
.breakdown-row{display:flex;justify-content:space-between;align-items:center;background:#0c0f14;border:1px solid #1e293b;border-radius:8px;padding:.6rem .9rem;margin-bottom:.4rem;font-size:.85rem}
.breakdown-row .bd-label{color:#cbd5e1}
.breakdown-row .bd-score{font-family:'IBM Plex Mono',monospace;font-weight:600}
.hist-wrap{text-align:left;margin-top:1.1rem}
.hist-wrap h3{font-family:'DM Sans',sans-serif;font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#94a3b8;margin:1rem 0 .5rem}
.hist-row{display:flex;justify-content:space-between;align-items:center;background:#0c0f14;border:1px solid #1e293b;border-radius:8px;padding:.5rem .9rem;margin-bottom:.35rem;font-size:.8rem}
.hist-row.best{border-color:#e11d48}
.h-date{color:#94a3b8;font-family:'IBM Plex Mono',monospace;font-size:.75rem}
.h-score{font-family:'IBM Plex Mono',monospace;font-weight:600}
.weak-row{display:flex;align-items:center;background:#0c0f14;border:1px solid #1e293b;border-radius:8px;padding:.45rem .9rem;margin-bottom:.3rem;font-size:.8rem}
.weak-row .w-ch{color:#cbd5e1;min-width:4.5rem}
.weak-bar{flex:1;height:5px;border-radius:99px;background:#1e293b;overflow:hidden;margin:0 .8rem}
.weak-bar i{display:block;height:100%;border-radius:99px}
.hist-empty{color:#64748b;font-size:.78rem;font-style:italic}
.hist-note{color:#64748b;font-size:.72rem;margin-top:.5rem;line-height:1.45}
.btn-clear{background:none;border:1px solid #334155;color:#64748b;border-radius:6px;padding:.3rem .6rem;font-size:.7rem;font-family:'IBM Plex Mono',monospace;cursor:pointer;margin-top:.6rem}
.btn-clear:hover{color:#ef4444;border-color:#ef4444}
.btn-restart{background:#1e293b;color:#e2e8f0;border:1px solid #334155;border-radius:8px;padding:.6rem 1.5rem;font-size:.85rem;font-weight:600;cursor:pointer;margin-top:1rem;transition:background .2s}
.btn-restart:hover{background:#334155}
.ref-grid{display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-top:1rem}
.ref-box{background:#0c0f14;border:1px solid #334155;border-radius:8px;padding:.85rem 1rem}
.ref-box h4{font-family:'DM Sans',sans-serif;font-size:.78rem;font-weight:700;margin-bottom:.55rem;text-transform:uppercase;letter-spacing:.04em;line-height:1.3}
.ref-box ul{list-style:none;display:flex;flex-direction:column;gap:.4rem}
.ref-box li{font-size:.82rem;color:#e2e8f0;line-height:1.45}
.ref-box li.dim{color:#94a3b8;font-size:.78rem}
.q-teach{margin-top:.85rem;background:#0c0f14;border:1px solid #334155;border-left:3px solid #fbbf24;border-radius:8px;padding:.7rem .9rem;font-size:.82rem;color:#cbd5e1;line-height:1.55}
.q-teach-lbl{display:block;font-family:'IBM Plex Mono',monospace;font-size:.66rem;letter-spacing:.08em;text-transform:uppercase;color:#fbbf24;margin-bottom:.35rem}
.opt,.btn-submit,.q-undo,.quiz-reset{touch-action:manipulation}
.q-undo{display:block;margin-top:.6rem;background:transparent;border:1px solid #475569;color:#94a3b8;border-radius:8px;padding:.55rem 1rem;min-height:44px;font-size:.78rem;font-family:inherit;cursor:pointer}
.q-undo:hover,.q-undo:active{border-color:#fbbf24;color:#fbbf24}
.quiz-reset{display:block;width:100%;margin:.6rem 0 1rem;background:transparent;border:1px dashed #475569;color:#64748b;border-radius:8px;padding:.6rem;min-height:44px;font-size:.78rem;font-family:inherit;cursor:pointer}
.quiz-reset:hover,.quiz-reset:active{border-color:#f87171;color:#f87171}
.back-link{display:inline-block;margin-bottom:1rem;color:#fb7185;text-decoration:none;font-size:.85rem;font-family:'IBM Plex Mono',monospace}
.back-link:hover{color:#fecdd3}
.chart-pin{position:fixed;bottom:1.1rem;right:1.1rem;z-index:100;background:#e11d48;color:#fff;border:1px solid #fb7185;border-radius:99px;padding:.6rem .95rem;font-family:'IBM Plex Mono',monospace;font-size:.75rem;font-weight:600;cursor:pointer;box-shadow:0 4px 16px rgba(0,0,0,.55)}
.chart-pin:hover{background:#be123c}
@media(max-width:600px){.q-card{padding:1rem}.exam-header h1{font-size:1.5rem}.exam-header{padding:1rem .5rem}.ref-grid{grid-template-columns:1fr}}

.filter-bar{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:18px 0 8px}
.filter-label{color:#94a3b8;font-size:13px;font-weight:700;margin-right:2px}
.fbtn{background:#13181f;border:1px solid #1e293b;color:#cbd5e1;border-radius:999px;
  padding:10px 14px;font-size:13px;font-weight:600;font-family:inherit;cursor:pointer;
  min-height:44px;touch-action:manipulation}
.fbtn:hover{border-color:#38bdf8}
.fbtn.active{background:#0c4a6e;border-color:#38bdf8;color:#e0f2fe}
.fbtn-hot{border-color:#f0abfc;color:#f5d0fe}
.fbtn-hot.active{background:#4a044e;border-color:#f0abfc;color:#fae8ff}
.fbtn-sata{border-color:#fbbf24;color:#fde68a}
.fbtn-sata.active{background:#451a03;border-color:#fbbf24;color:#fef3c7}
.filter-note{color:#94a3b8;font-size:13px;margin:0 0 10px}

.btn-missed{display:none;margin-top:.6rem;background:#1e3a2f;color:#34d399;border:1.5px solid #34d399;
  border-radius:9px;padding:.55rem 1.3rem;font-size:.85rem;font-weight:700;cursor:pointer;width:100%}
.btn-missed:hover{background:#14532d}


.sync-link:hover{opacity:1;background:#0f172a}
.sync-link{position:fixed;bottom:1rem;left:1rem;background:#1e293b;color:#7c3aed;border:1px solid #334155;border-radius:8px;padding:.45rem .85rem;font-size:.75rem;font-weight:600;text-decoration:none;z-index:9999;opacity:.88}.sync-link:hover{opacity:1;background:#0f172a}
